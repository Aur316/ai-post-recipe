PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/recipe

# Object storage: any S3-compatible service.
# Local default: the SeaweedFS container from docker-compose.yml.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
# and an R2 API token's access key and secret.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=ai-post-recipe
S3_ACCESS_KEY=storage
S3_SECRET_KEY=storage12345

# AI models through OpenRouter (https://openrouter.ai/keys). Without a key the
# pipeline uses recorded fake answers, so the app still runs end to end.
OPENROUTER_API_KEY=
# Web search for the research phase (https://serper.dev). Optional: without it
# research reads only the links in the brief.
SERPER_API_KEY=
# No LLM call starts once a run has spent this much (USD).
MAX_COST_USD_PER_RUN=2
# Override a prompt's model: MODEL_<PROMPT ID>, e.g.
# MODEL_ANALYSIS=google/gemini-3.5-flash
