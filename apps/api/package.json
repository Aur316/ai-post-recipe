{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "postinstall": "prisma generate && playwright install chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-post-recipe/prompts": "workspace:*",
    "@ai-post-recipe/shared": "workspace:*",
    "@ai-post-recipe/slide-templates": "workspace:*",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "1.65.1",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-post-recipe/eslint-config": "workspace:*",
    "@ai-post-recipe/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
